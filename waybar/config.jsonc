// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 5, // Gaps between modules (4px)

    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "network",
        "pulseaudio",
        "battery",
        "clock"
    ],

    // Module configurations.
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/workspaces": {
        "all-outputs": true,
        "format": "{index}"
    },

    "cpu": {
        "interval": 10,
        "format": "cpu: {load} {usage}%",
        // "format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
        // "format": "cpu: {icon}",
        // "format-icons": [
        //     "<span color='#69ff94'>▁</span>", // green
        //     "<span color='#2aa9ff'>▂</span>", // blue
        //     "<span color='#f8f8f2'>▃</span>", // white
        //     "<span color='#f8f8f2'>▄</span>", // white
        //     "<span color='#ffffa5'>▅</span>", // yellow
        //     "<span color='#ffffa5'>▆</span>", // yellow
        //     "<span color='#ff9977'>▇</span>", // orange
        //     "<span color='#dd532e'>█</span>"  // red
        // ]
    },

    "memory": {
        "interval": 10,
        "format": "mem: {used}/{total} {percentage}%"
    },

    "disk": {
        "format": "dsk: {percentage_used}%"
    },

    // Documentation
    // https://github.com/Alexays/Waybar/wiki/Module:-Clock
    "clock": {
        "interval": 1,
        "format":"{:%D %T}",
        "timezone": "America/New_York",
        "tooltip": false
    },

    // Documentation
    // https://github.com/Alexays/Waybar/wiki/Module:-Battery
    "battery": {
	"bat": "BAT0",
        "interval": 10,
        "states": {
            "critical": 20
        },
        "format": "bat: {capacity}% {power:2.0f}W",
        "tooltip": false
    },

    // Documentation
    // https://github.com/Alexays/Waybar/wiki/Module:-PulseAudio
    "pulseaudio": {
        "format": "vol: {volume}%",
        "tooltip": false
    },

    // Documentation
    // https://github.com/Alexays/Waybar/wiki/Module:-Network
    "network": {
        "format": "net: {essid}",
        "tooltip": false
    }
}

